{
	"name": "df_dim_cliente",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_BLOBL_JSON_RAW",
						"type": "DatasetReference"
					},
					"name": "jsonusers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "freesql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "flatten1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          limit as short,",
				"          skip as boolean,",
				"          total as short,",
				"          users as (address as (address as string, city as string, coordinates as (lat as double, lng as double), country as string, postalCode as integer, state as string, stateCode as string), email as string, firstName as string, gender as string, id as short, lastName as string)[]",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'documentPerLine') ~> jsonusers",
				"jsonusers foldDown(unroll(users),",
				"     mapColumn(",
				"          email = users.email,",
				"          nome = users.firstName,",
				"          sobrenome = users.lastName,",
				"          genero = users.gender,",
				"          id_cliente = users.id,",
				"          cidade = users.address.city,",
				"          pais = users.address.country,",
				"          estado = users.address.state",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"select1 derive(nome = concat(nome,' ', sobrenome)) ~> derivedColumn1",
				"flatten1 select(mapColumn(",
				"          email,",
				"          nome,",
				"          sobrenome,",
				"          genero,",
				"          id_cliente,",
				"          cidade,",
				"          pais,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          CLIENTE_SK as integer,",
				"          CLIENTE_ID as integer,",
				"          NOME as string,",
				"          EMAIL as string,",
				"          GENERO as string,",
				"          CIDADE as string,",
				"          ESTADO as string,",
				"          PAIS as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     dateFormat:'dd/MM/yyyy',",
				"     timestampFormat:'dd/MM/yyyy',",
				"     booleanFormat: ['1', '0'],",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          CLIENTE_ID = id_cliente,",
				"          NOME = nome,",
				"          EMAIL = email,",
				"          GENERO = genero,",
				"          CIDADE = cidade,",
				"          ESTADO = estado,",
				"          PAIS = pais",
				"     )) ~> sink1"
			]
		}
	}
}