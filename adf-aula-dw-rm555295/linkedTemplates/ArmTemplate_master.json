{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nome do Data Factory",
			"defaultValue": "adf-aula-dw-rm555295"
		},
		"bancodedadosql_password": {
			"type": "secureString",
			"metadata": "Cadeia de caracteres segura para 'password' de 'bancodedadosql'"
		},
		"dadosbrutos_bronze_connectionString": {
			"type": "secureString",
			"metadata": "Cadeia de caracteres segura para 'connectionString' de 'dadosbrutos_bronze'"
		},
		"ORCL_fiap_password": {
			"type": "secureString",
			"metadata": "Cadeia de caracteres segura para 'password' de 'ORCL_fiap'"
		},
		"bancodedadosql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "rm555295-dw.database.windows.net"
		},
		"bancodedadosql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-6138434"
		},
		"bancodedadosql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin-rm555295"
		},
		"ORCL_fiap_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "oracle.fiap.com.br:1521/ORCL"
		},
		"ORCL_fiap_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "rm555295"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI para a conta de armazenamento contendo os modelos do ARM vinculados"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token SAS para a conta de armazenamento contendo modelos do ARM vinculados"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-aula-dw-rm555295_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"bancodedadosql_password": {
						"value": "[parameters('bancodedadosql_password')]"
					},
					"dadosbrutos_bronze_connectionString": {
						"value": "[parameters('dadosbrutos_bronze_connectionString')]"
					},
					"ORCL_fiap_password": {
						"value": "[parameters('ORCL_fiap_password')]"
					},
					"bancodedadosql_properties_typeProperties_server": {
						"value": "[parameters('bancodedadosql_properties_typeProperties_server')]"
					},
					"bancodedadosql_properties_typeProperties_database": {
						"value": "[parameters('bancodedadosql_properties_typeProperties_database')]"
					},
					"bancodedadosql_properties_typeProperties_userName": {
						"value": "[parameters('bancodedadosql_properties_typeProperties_userName')]"
					},
					"ORCL_fiap_properties_typeProperties_server": {
						"value": "[parameters('ORCL_fiap_properties_typeProperties_server')]"
					},
					"ORCL_fiap_properties_typeProperties_username": {
						"value": "[parameters('ORCL_fiap_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}